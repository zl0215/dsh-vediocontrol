{
  "name": "dsh-push-to-talk",
  "version": "0.3.0",
  "type": "module",
  "description": "Hold-and-talk dictation, one-key screenshot sending and optional WeChat reply mirroring for DeepSeek Harness: hold to record and release to transcribe, press one key to capture the screen, or mirror the reply of that turn to your phone.",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "wzl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zl0215/dsh-vediocontrol.git"
  },
  "homepage": "https://github.com/zl0215/dsh-vediocontrol#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "push-to-talk",
    "screenshot",
    "wechat",
    "hold-to-talk",
    "voice-input",
    "speech-to-text",
    "dictation",
    "sensevoice",
    "windows"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1",
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "hotkey.ps1",
    "screenshot.ps1",
    "overlay.ps1",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "locale/*.json",
    "NOTICE.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
